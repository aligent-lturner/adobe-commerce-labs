{
  "name": "customer-welcome-notifier",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@adobe/aio-commerce-lib-admin-ui": "^1.3.0",
    "@adobe/aio-commerce-lib-app": "^2.0.0",
    "@adobe/aio-commerce-lib-auth": "^1.3.0",
    "@adobe/aio-commerce-lib-config": "^1.9.0",
    "@adobe/aio-commerce-sdk": "^2.1.0",
    "@adobe/aio-lib-db": "^1.1.0",
    "@babel/core": "^7.29.13",
    "@babel/preset-react": "^7.29.7",
    "@ljharb/tsconfig": "^0.2.3",
    "@react-spectrum/s2": "^1.8.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tsconfig/bases": "^1.0.30"
  },
  "description": "Notifies an external welcome service with the customer's email and creation timestamp when a new Commerce customer account is created.",
  "scripts": {
    "test": "node --test src/commerce-extensibility-1/actions/handle-customer-created/__tests__/*.test.mjs src/commerce-backend-ui-2/actions/get-welcome-history/__tests__/*.test.mjs src/commerce-backend-ui-2/actions/rotate-history-key/__tests__/*.test.mjs",
    "ci:yaml": "node scripts/ci-verify.mjs yaml",
    "ci:secrets": "node scripts/ci-verify.mjs secrets",
    "ci:generated": "node scripts/ci-verify.mjs generated",
    "typecheck:actions": "tsc --noEmit -p tsconfig.json",
    "typecheck:web-src": "tsc --noEmit -p src/commerce-backend-ui-2/web-src/tsconfig.json",
    "typecheck": "npm run typecheck:actions && npm run typecheck:web-src",
    "postinstall": "npx aio-commerce-lib-app hooks postinstall"
  },
  "imports": {
    "#app.commerce.config": "./src/commerce-extensibility-1/.generated/app.commerce.config.js",
    "#web/*": "./src/commerce-backend-ui-2/web-src/src/*"
  },
  "@parcel/bundler-default": {
    "manualSharedBundles": [
      {
        "assets": [
          "**/@react-spectrum/s2/**",
          "src/commerce-backend-ui-2/web-src/*.{js,jsx,ts,tsx}"
        ],
        "name": "s2-styles",
        "types": [
          "css"
        ]
      }
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
